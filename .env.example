GROQ_API_KEY=
# Uses the same Groq key for grounded server-side web search when Tavily is absent.
GROQ_WEB_SEARCH_MODEL=groq/compound-mini
# Optional direct web-search API. When absent, Groq web search is used before Bing/DDG.
TAVILY_API_KEY=
# Later, for our own Microsoft Graph app:
MS_CLIENT_ID=
MS_TENANT_ID=common
