# Use AWS IAM Identity Center locally. Run `aws sso login --profile <name>` first.
AWS_PROFILE=
# SSO can live in ap-southeast-1 while Bedrock and AgentCore run in us-east-1.
AWS_REGION=us-east-1
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional task-specific overrides; blank values use AWS_BEDROCK_MODEL_ID.
AWS_BEDROCK_EXTRACTION_MODEL_ID=
AWS_BEDROCK_STAGE2_MODEL_ID=
AWS_BEDROCK_JUDGE_MODEL_ID=
AWS_BEDROCK_RESEARCH_MODEL_ID=

# Created once by scripts/setup_aws_agentcore_search.py.
AWS_AGENTCORE_REGION=us-east-1
AWS_AGENTCORE_MCP_VERSION=2026-07-28
AWS_AGENTCORE_GATEWAY_URL=
AWS_AGENTCORE_WEB_SEARCH_TOOL=simplenext-web-search___WebSearch
# Demo cost controls: at most 15 AgentCore network attempts per process;
# successful query results are reused locally for 12 hours.
SIMPLYNEXT_AGENTCORE_MAX_CALLS=15
SIMPLYNEXT_AGENTCORE_CACHE_TTL_SECONDS=43200
# Optional grounded fallback. Used once per unresolved shortlisted role only.
GROQ_API_KEY=
GROQ_WEB_SEARCH_MODEL=groq/compound-mini
GROQ_BROWSER_SEARCH_MODEL=openai/gpt-oss-20b
SIMPLYNEXT_GROQ_SEARCH_MAX_CALLS=15

# Later, for our own Microsoft Graph app:
MS_CLIENT_ID=
MS_TENANT_ID=common
